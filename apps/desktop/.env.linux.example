# Copy to .env.linux (Git ignored). Use UTF-8. Values are not shell-expanded.
# A Linux release is built unsigned and carries no update feed or mandatory-update policy,
# so it needs no signing, notarization, upload, or service-origin settings.
DSH_DESKTOP_APP_ID=com.deepseek.harness

# Source commit embedded in the client bundle and shown in the local build badge.
# A release built from a Git checkout omits this and reads HEAD instead; a build from a
# source archive sets it, because the archive carries no history to name.
# DSH_CLIENT_COMMIT_HASH=0000000

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# A local mirror such as https://registry.npmmirror.com speeds up repeated local packages.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com

# Optional upload configuration; a Linux release publishes no feed, so packaging ignores these.
# DOWNLOAD_TEST_COS_BUCKET=
# DOWNLOAD_TEST_COS_SECRET_ID=
# DOWNLOAD_TEST_COS_SECRET_KEY=
